rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all unlisted documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Username Lookup Collection: Minimal mapping (uid, email, username) for username-based login
    // allow get: allows reading a single known username document (/usernames/{username}) for login lookup
    // allow list: false strictly prevents enumeration, querying, or scraping of the collection
    // Creation requires authenticated user matching target UID and correct username field
    // Update/Delete requires matching existing document UID and immutable uid field
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == username;
      allow update: if request.auth != null 
                    && resource.data.uid == request.auth.uid 
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == username;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Users Collection: Only the authenticated user whose request.auth.uid equals {uid} can access
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Transactions Subcollection: Individual transaction documents isolated per user
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Cross-Device Cloud Ledgers: Accessible by direct Ledger Link or ID
    // allow get: permits loading a specific ledger on any device holding the link
    // allow list: false strictly blocks enumeration or scraping of all ledgers
    // allow create, update: allows any device holding the ledger link to save transactions and sync
    match /ledgers/{ledgerId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}


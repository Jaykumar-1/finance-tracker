rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: every collection must be explicitly allowed below.
    match /{document=**} {
      allow read, write: if false;
    }

    // Username lookup is used before authentication for username-based login.
    // A single known username can be looked up, but collection enumeration is blocked.
    // Keep this document limited to the minimum login mapping fields only.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == username;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == username;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // A signed-in user can access only their own profile and transaction subcollection.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Private cloud JSON ledger. The existing app stores ownerUid on the ledger.
    // Same-account sign-in on another device continues to sync; a ledger ID or URL
    // alone is NOT authorization. Unowned legacy ledgers must be claimed safely
    // before these rules are deployed (see SECURITY_SETUP.md).
    match /ledgers/{ledgerId} {
      allow get: if request.auth != null
                 && resource.data.ownerUid == request.auth.uid;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }
  }
}
